---
// Replaces Starlight's social icons with the Download button.
---

<a
	class="download"
	href="https://apps.apple.com/app/id6748625363?pt=127982700&ct=wt_help_nav&mt=8"
	data-download-location="wt_help_nav"
	aria-label="Download on the App Store"
	title="Download on the App Store"
>
	<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M12 4v11" />
		<path d="m7 11 5 5 5-5" />
		<path d="M5 20h14" />
	</svg>
</a>

<script is:inline src="/assets/app-store-tracking.js" data-app-id="6748625363" data-app="wealthtrunk" defer></script>

<style>
	.download {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		color: #fff;
		background: var(--sl-color-accent);
		border-radius: 999px;
		text-decoration: none;
	}
	.download:hover {
		filter: brightness(1.1);
	}
</style>
