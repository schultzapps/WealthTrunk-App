---
// Replaces Starlight's social icons with the Download button.
---

<a
	class="download"
	href="https://apps.apple.com/app/id6748625363?pt=127982700&ct=wt_help_nav&mt=8"
	data-download-location="wt_help_nav">Download</a
>

<script is:inline>
	document.addEventListener('click', function (e) {
		var link = e.target.closest('a[href*="apps.apple.com/app/id6748625363"]');
		if (!link || typeof gtag !== 'function') return;
		gtag('event', 'download_app_click', {
			button_location: link.getAttribute('data-download-location') || 'unknown',
			destination: 'appstore',
			app: 'wealthtrunk',
		});
	});
</script>

<style>
	a {
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
	}
	.download {
		color: #fff;
		background: var(--sl-color-accent);
		padding: 0.35rem 0.9rem;
		border-radius: 999px;
	}
	.download:hover {
		filter: brightness(1.1);
	}
</style>
