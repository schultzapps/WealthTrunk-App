---
// Every page carries a preview notice while the help center is being built.
// A page can still set its own `banner` in frontmatter to replace it.
import Default from '@astrojs/starlight/components/Banner.astro';

const { banner } = Astro.locals.starlightRoute.entry.data;
---

{
	banner ? (
		<Default />
	) : (
		<div class="sl-banner" data-pagefind-ignore>
			Early preview. More articles coming soon. <a href={`${import.meta.env.BASE_URL}/contact/`}>Contact us</a>
		</div>
	)
}

<style>
	.sl-banner {
		padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
		background-color: var(--sl-color-accent-low);
		color: var(--sl-color-white);
		line-height: var(--sl-line-height-headings);
		text-align: center;
		text-wrap: balance;
		font-size: var(--sl-text-sm);
	}
	.sl-banner a {
		color: inherit;
		font-weight: 600;
	}
</style>
