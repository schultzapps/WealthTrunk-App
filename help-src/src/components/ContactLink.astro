---
// Same obfuscated support address as the main site's "Contact Us" link.
const { label = 'Email support' } = Astro.props;
---

<a href="#" class="wt-contact-link">{label}</a>

<script is:inline>
	document.querySelectorAll('.wt-contact-link').forEach(function (link) {
		link.addEventListener('click', function (e) {
			e.preventDefault();
			window.location.href =
				'mail' + 'to:' + 'hello' + '@' + 'wealthtrunk.app' + '?subject=' + encodeURIComponent('WealthTrunk Help');
		});
	});
</script>
